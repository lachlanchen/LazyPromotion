    {
      "id": "ch-02",
      "title": {
        "en": "Design for paper and reflow",
        "zh-Hant": "同時為紙頁與流式閱讀設計"
      },
      "paragraphs": [
        {
          "id": "p-003",
          "source_location": "source/book.json#/chapters/1/paragraphs/0",
          "status": "reviewed",
          "reviewer_notes": "Project-authored bilingual sentence; structure and terminology reviewed on 2026-09-07.",
          "main": {
            "language": "en",
            "text": "Print and reflowable books solve different reading problems; a fixed page protects composition, while EPUB lets the reader change type size.",
            "tokens": [
              {"text": "Print and reflowable books", "role": "subject"},
              {"text": "solve", "role": "predicate"},
              {"text": "different reading problems;", "role": "object"},
              {"text": "a fixed page", "role": "subject"},
              {"text": "protects", "role": "predicate"},
              {"text": "composition,", "role": "object"},
              {"text": "while EPUB", "role": "subject"},
              {"text": "lets", "role": "predicate"},
              {"text": "the reader change type size.", "role": "object"}
            ]
          },
          "comment": {
            "language": "zh-Hant",
            "text": "印刷書與流式電子書解決不同的閱讀問題；固定頁面保護版式，EPUB則讓讀者調整字級。",
            "tokens": [
              {"text": "印刷書與流式電子書", "reading": "yìn shuā shū yǔ liú shì diàn zǐ shū", "role": "subject"},
              {"text": "解決", "reading": "jiě jué", "role": "predicate"},
              {"text": "不同的閱讀問題", "reading": "bù tóng de yuè dú wèn tí", "role": "object"},
              {"text": "；", "reading": "", "role": "function"},
              {"text": "固定頁面", "reading": "gù dìng yè miàn", "role": "subject"},
              {"text": "保護", "reading": "bǎo hù", "role": "predicate"},
              {"text": "版式", "reading": "bǎn shì", "role": "object"},
              {"text": "，EPUB則讓讀者調整字級。", "reading": "，EPUB zé ràng dú zhě tiáo zhěng zì jí。", "role": "complement"}
            ]
          }
        },
        {
          "id": "p-004",
          "source_location": "source/book.json#/chapters/1/paragraphs/1",
          "status": "reviewed",
          "reviewer_notes": "Project-authored bilingual sentence; structure and terminology reviewed on 2026-09-07.",
          "main": {
            "language": "en",
            "text": "The structure stays the same in both outputs: title, chapter, paragraph, source ID, and review state.",
            "tokens": [
              {"text": "The structure", "role": "subject"},
              {"text": "stays", "role": "predicate"},
              {"text": "the same", "role": "complement"},
              {"text": "in both outputs:", "role": "adverbial"},
              {"text": "title, chapter, paragraph, source ID, and review state.", "role": "object"}
