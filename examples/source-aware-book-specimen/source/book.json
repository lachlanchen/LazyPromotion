    {
      "id": "ch-03",
      "title": {
        "en": "Finish with checks",
        "zh-Hant": "以檢查完成製作"
      },
      "paragraphs": [
        {
          "id": "p-005",
          "source_location": "source/book.json#/chapters/2/paragraphs/0",
          "status": "reviewed",
          "reviewer_notes": "Project-authored bilingual sentence; structure and terminology reviewed on 2026-09-07.",
          "main": {
            "language": "en",
            "text": "A build is not finished when the files merely open. The PDF needs page, font, and text checks; the EPUB needs package, navigation, and link checks.",
            "tokens": [
              {"text": "A build", "role": "subject"},
              {"text": "is not finished", "role": "predicate"},
              {"text": "when the files merely open.", "role": "adverbial"},
              {"text": "The PDF", "role": "subject"},
              {"text": "needs", "role": "predicate"},
              {"text": "page, font, and text checks;", "role": "object"},
              {"text": "the EPUB", "role": "subject"},
              {"text": "needs", "role": "predicate"},
              {"text": "package, navigation, and link checks.", "role": "object"}
            ]
          },
          "comment": {
            "language": "zh-Hant",
            "text": "檔案能打開並不代表製作完成。PDF需要頁面、字型與文字檢查；EPUB需要封裝、導覽與連結檢查。",
            "tokens": [
              {"text": "檔案能打開", "reading": "dàng àn néng dǎ kāi", "role": "subject"},
              {"text": "並不代表", "reading": "bìng bù dài biǎo", "role": "predicate"},
              {"text": "製作完成", "reading": "zhì zuò wán chéng", "role": "object"},
              {"text": "。PDF", "reading": "。PDF", "role": "subject"},
              {"text": "需要", "reading": "xū yào", "role": "predicate"},
              {"text": "頁面、字型與文字檢查", "reading": "yè miàn、zì xíng yǔ wén zì jiǎn chá", "role": "object"},
              {"text": "；EPUB", "reading": "；EPUB", "role": "subject"},
              {"text": "需要封裝、導覽與連結檢查", "reading": "xū yào fēng zhuāng、dǎo lǎn yǔ lián jié jiǎn chá", "role": "predicate"},
              {"text": "。", "reading": "", "role": "function"}
            ]
          }
        },
        {
          "id": "p-006",
          "source_location": "source/book.json#/chapters/2/paragraphs/1",
          "status": "reviewed",
          "reviewer_notes": "Project-authored bilingual sentence; structure and terminology reviewed on 2026-09-07.",
          "main": {
            "language": "en",
            "text": "The specimen ends with a boundary: translation, editing, cover design, platform upload, printing, and the complete book require a separate scope.",
            "tokens": [
