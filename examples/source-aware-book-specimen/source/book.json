          "status": "reviewed",
          "reviewer_notes": "Project-authored bilingual sentence; structure and terminology reviewed on 2026-09-07.",
          "main": {
            "language": "en",
            "text": "This specimen keeps a stable ID, language, status, and source location beside every reviewed paragraph.",
            "tokens": [
              {"text": "This", "role": "attributive"},
              {"text": "specimen", "role": "subject"},
              {"text": "keeps", "role": "predicate"},
              {"text": "a stable ID, language, status, and source location", "role": "object"},
              {"text": "beside every reviewed paragraph.", "role": "adverbial"}
            ]
          },
          "comment": {
            "language": "zh-Hant",
            "text": "這份樣本在每個已審閱段落旁保留穩定編號、語言、狀態與來源位置。",
            "tokens": [
              {"text": "這份", "reading": "zhè fèn", "role": "attributive"},
              {"text": "樣本", "reading": "yàng běn", "role": "subject"},
              {"text": "在每個已審閱段落旁", "reading": "zài měi ge yǐ shěn yuè duàn luò páng", "role": "adverbial"},
              {"text": "保留", "reading": "bǎo liú", "role": "predicate"},
              {"text": "穩定編號、語言、狀態與來源位置", "reading": "wěn dìng biān hào、yǔ yán、zhuàng tài yǔ lái yuán wèi zhì", "role": "object"},
              {"text": "。", "reading": "", "role": "function"}
            ]
          }
        }
      ]
