              {"text": "book", "role": "subject"},
              {"text": "begins", "role": "predicate"},
              {"text": "with", "role": "function"},
              {"text": "a source", "role": "object"},
              {"text": "you", "role": "subject"},
              {"text": "can reopen.", "role": "predicate"}
            ]
          },
          "comment": {
            "language": "zh-Hant",
            "text": "一本可靠的書始於可以重新打開的來源。",
            "tokens": [
              {"text": "一本可靠的", "reading": "yì běn kě kào de", "role": "attributive"},
              {"text": "書", "reading": "shū", "role": "subject"},
              {"text": "始於", "reading": "shǐ yú", "role": "predicate"},
