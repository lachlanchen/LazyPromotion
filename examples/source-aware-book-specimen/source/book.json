          "comment": {
            "language": "zh-Hant",
            "text": "兩種輸出保留同一結構：書名、章節、段落、來源編號與審閱狀態。",
            "tokens": [
              {"text": "兩種輸出", "reading": "liǎng zhǒng shū chū", "role": "subject"},
              {"text": "保留", "reading": "bǎo liú", "role": "predicate"},
              {"text": "同一結構", "reading": "tóng yī jié gòu", "role": "object"},
              {"text": "：", "reading": "", "role": "function"},
              {"text": "書名、章節、段落、來源編號與審閱狀態", "reading": "shū míng、zhāng jié、duàn luò、lái yuán biān hào yǔ shěn yuè zhuàng tài", "role": "object"},
              {"text": "。", "reading": "", "role": "function"}
            ]
          }
        }
