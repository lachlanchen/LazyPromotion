              {"text": "a separate scope.", "role": "object"}
            ]
          },
          "comment": {
            "language": "zh-Hant",
            "text": "樣本最後劃清界線：翻譯、編輯、封面設計、平台上傳、印刷與完整書稿都需要另行約定。",
            "tokens": [
              {"text": "樣本", "reading": "yàng běn", "role": "subject"},
              {"text": "最後劃清", "reading": "zuì hòu huà qīng", "role": "predicate"},
              {"text": "界線", "reading": "jiè xiàn", "role": "object"},
              {"text": "：", "reading": "", "role": "function"},
              {"text": "翻譯、編輯、封面設計、平台上傳、印刷與完整書稿", "reading": "fān yì、biān jí、fēng miàn shè jì、píng tái shàng chuán、yìn shuā yǔ wán zhěng shū gǎo", "role": "subject"},
              {"text": "都需要", "reading": "dōu xū yào", "role": "predicate"},
              {"text": "另行約定", "reading": "lìng xíng yuē dìng", "role": "object"},
              {"text": "。", "reading": "", "role": "function"}
            ]
          }
        }
      ]
